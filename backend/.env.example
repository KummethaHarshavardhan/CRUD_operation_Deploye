# Port the server listens on (hosting platforms like Render/Railway set this automatically)
PORT=5050
# Local MongoDB, or a MongoDB Atlas connection string for deployment
MONGO_URI=mongodb://127.0.0.1:27017/product_crud_db
# Deployed frontend origin allowed by CORS, e.g. https://your-frontend.example.com
# Leave empty during local development to allow all origins
CLIENT_URL=
